PROXY_PORT=4344

# ANTHROPIC_TARGET_PROVIDER selects how the anthropic route reaches its upstream:
#   openai-compatible (default) - convert Anthropic <-> OpenAI Chat Completions
#   anthropic                   - talk directly to the Anthropic Messages API
# For the direct mode point ANTHROPIC_TARGET_BASE_URL at https://api.anthropic.com/v1
ANTHROPIC_TARGET_PROVIDER=openai-compatible
ANTHROPIC_TARGET_BASE_URL=https://api.eliza.yandex.net/openrouter/v1
ANTHROPIC_API_KEY=

OPENAI_TARGET_BASE_URL=https://api.eliza.yandex.net/raw/openai/v1
OPENAI_API_KEY=

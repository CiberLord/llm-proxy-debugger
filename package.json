    "build": "tsup",
    "start": "tsup && node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:build:client": "vite build --config src/ui/client/vite.config.ts",
    "ui:seed": "tsx scripts/seed-sample-sessions.ts",
    "ui:shots": "tsx scripts/screenshot-ui.ts",
    "ui": "npm run ui:build:client && tsup && node dist/ui/server/index.js",
    "ui:dev": "concurrently -k -n api,web \"tsx watch src/ui/server/index.ts\" \"vite --config src/ui/client/vite.config.ts\""
  },
